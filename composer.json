{
    "name": "ghostauth/ghostauth",
    "description": "Enterprise-grade, framework-agnostic PHP 8.3+ authentication package inspired by Auth0.",
    "type": "library",
    "license": "MIT",
    "keywords": ["authentication", "auth", "jwt", "otp", "oauth", "sso", "oidc", "security"],
    "authors": [
        {
            "name": "GhostAuth Contributors",
            "email": "hello@ghostauth.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^6.10",
        "psr/log": "^3.0",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "GhostAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GhostAuth\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
